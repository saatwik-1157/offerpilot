# Copy to .env and fill in. .env is gitignored — never commit a real key.
# Read by apps/api/server/rezforge-server.mjs and apps/api/functions/rezforge.js.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# Required for live RezForge resumes (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: Claude model id (default: claude-opus-4-8)
REZFORGE_MODEL=

# Optional: CORS origin allowed to call the API (default: *). Lock to your site in production.
ALLOW_ORIGIN=

# Optional: port for the standalone server, `npm run api` (default: 8787)
PORT=

# Optional: port for the local static site, `npm run web` (default: 8981)
WEB_PORT=
